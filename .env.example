# XAMPP MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mutale

# API server
PORT=4000

# Payment gateway defaults (Lenco)
PAYMENT_PROVIDER=lenco
PAYMENT_CURRENCY=ZMW
LENCO_PUBLIC_KEY=
LENCO_SECRET_KEY=
# Lenco dashboard Signature key (APIs → Webhook). Preferred for webhook verification.
LENCO_WEBHOOK_SECRET=
LENCO_ACCOUNT_ID=
LENCO_SANDBOX=true
# Register this public URL with Lenco support for instant collection.successful / collection.failed:
#   https://YOUR_DOMAIN/api/webhooks/lenco

# Security hardening (required in production)
# Comma-separated list, e.g. http://localhost:5173,https://yourdomain.com
# In production, unset CORS_ORIGINS blocks cross-origin API access (fail-closed).
CORS_ORIGINS=http://localhost:5173

# Public app URL (used for same-origin CORS and email links)
APP_URL=http://localhost:5173

# Mobile app (Expo) on the same LAN — point EXPO_PUBLIC_API_URL on the phone to:
# http://<your-lan-ip>:4000/api
# The API listens on 0.0.0.0:4000, so no extra server config is needed for LAN dev.

# Behind nginx/cPanel reverse proxy — enables correct client IP for rate limits
TRUST_PROXY=1

# If set, sensitive admin API endpoints require either:
# - Header: x-admin-api-key: <value>
# - or Authorization: Bearer <value>
ADMIN_API_KEY=

# HMAC secret used to sign user auth tokens for protected profile updates
# Use a long random string in production.
AUTH_TOKEN_SECRET=

# Ontech Bulk SMS (or configure in Admin → Settings → SMS)
ONTECH_SMS_ENABLED=false
ONTECH_BASE_URL=https://bulksms.ontech.co.zm/smsservice
ONTECH_ACCESS_ID=
ONTECH_SENDER_ID=

# Zoom (virtual events — optional if configured in Admin → Video Meetings)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_DEFAULT_HOST_EMAIL=
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# Daily.co (virtual events — optional if configured in Admin → Video Meetings)
DAILY_API_KEY=
DAILY_DOMAIN=
DAILY_WEBHOOK_SECRET=

# Ticket / Receipt PDF generation
# Default: branded HTML PDF via Puppeteer (matches web + mobile ticket UI, used for email attachments).
# Set TICKET_PDF_LEGACY=1 or RECEIPT_PDF_LEGACY=1 only on hosts without Chromium (e.g. some cPanel setups).
TICKET_PDF_LEGACY=
RECEIPT_PDF_LEGACY=
# Optional: fail hard instead of falling back to legacy when HTML PDF fails
TICKET_PDF_HTML=
RECEIPT_PDF_HTML=
